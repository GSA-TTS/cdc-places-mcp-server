# watsonx Orchestrate connection for the LOCAL MCP toolkit (stdio).
#
# Copy to .env and fill in, then: `source ibm/local-mcp-toolkit/.env`.
# NO secrets belong in this file — only your Orchestrate instance URL and the
# environment name. The API key is passed to `orchestrate env activate` at
# runtime (see README), never stored here.

# Name to give the Orchestrate ADK environment (arbitrary, local label).
WXO_ENV_NAME=gsa-hackathon

# Your watsonx Orchestrate SaaS instance URL. Find it in the Orchestrate service
# page in IBM Cloud (Resource List -> your wxO instance), or in
# ibm/internal/credentials.txt (WXO_INSTANCE_URL).
# Example:
#   WXO_INSTANCE_URL=https://api.us-south.watson-orchestrate.cloud.ibm.com/instances/<id>
WXO_INSTANCE_URL=

# Name to register the toolkit under in Orchestrate (matches toolkit.yaml `name`).
TOOLKIT_NAME=cdc_places_local

# --- API key (NOT stored here) -----------------------------------------------
# Provide your Orchestrate API key at runtime via the WXO_API_KEY env var:
#   export WXO_API_KEY="<your key>"
# If unset, the register script prompts for it (input hidden) and never writes
# it to disk.
# WXO_API_KEY=   # <- leave commented; set via `export` in your shell only
