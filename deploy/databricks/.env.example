# Databricks Apps deployment configuration for your MCP server.
#
# Copy to .env and fill in, then:
#   set -a; source deploy/databricks/.env; set +a
# before running the deploy script.
#
# This file contains NO secrets. Databricks authentication is handled by the
# Databricks CLI (an OAuth login or a DATABRICKS_TOKEN in your environment/CLI
# profile), NOT stored here.

# --- Databricks workspace -----------------------------------------------------
# Your workspace URL. Also settable via the CLI profile; if set here the deploy
# script passes it through.
#   DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_HOST=

# CLI profile to use (from `databricks configure` / ~/.databrickscfg).
# Leave as DEFAULT unless you configured a named profile.
DATABRICKS_CONFIG_PROFILE=DEFAULT

# --- App identity -------------------------------------------------------------
# Name of the Databricks App (created on first deploy). Use your server's name;
# lowercase letters, numbers, and hyphens.
APP_NAME=example-mcp-server

# Workspace path where the app source code is uploaded (the deploy script syncs
# the repo here, then deploys from it). Must be an absolute workspace path.
# Replace <you> with your workspace username/email.
SOURCE_CODE_PATH=/Workspace/Users/<you>/example-mcp-server
